{
  "_README": [
    "EDIT THIS FILE, not suas/config.py.",
    "Every value here overrides the documented default in suas/config.py.",
    "Delete any key to fall back to its default. Section names are for readability only.",
    "Verify your settings with:  python3 tools/show_config.py",
