  "profile": {
    "SIM_MODE": false
  },

  "_network_help": [
    "Documentation only -- fill these in with your own addresses if you like.",
    "Nothing in the code reads them; the code uses CAMERA_RTSP_URL_* and STREAM_HOST."
  ],
  "network": {
    "COMPANION_IP": "",
    "GROUND_STATION_IP": "",
    "SIM_HOST_IP": ""
  },

  "_flight_controller_help": [
    "MAVLINK_CONNECT_REAL: REQUIRED. Prefer a stable /dev/serial/by-id/... path over",
    "/dev/ttyACM0, which changes across reboots. List yours with:  ls -l /dev/serial/by-id/",
    "A UDP/TCP endpoint such as udpin:0.0.0.0:14550 also works."
  ],
  "flight_controller": {
    "MAVLINK_CONNECT_REAL": "",
    "MAVLINK_CONNECT_SIM": "udpin:0.0.0.0:14560"
  },

  "_camera_help": [
    "CAMERA_RTSP_URL_REAL: REQUIRED in rtsp mode. Your camera's stream URL,",
    "e.g. rtsp://<camera-ip>:8554/main.264 -- check your camera's manual."
  ],
